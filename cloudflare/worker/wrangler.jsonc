{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "telebudget-consumer",
  "main": "./index.js",
  "compatibility_date": "2026-09-24",
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "telebudget-db",
    "database_id": "0191b1df-de41-41c9-9e65-32555810bf33",
    "migrations_dir": "../migrations"
  }],
  "queues": { "consumers": [{ "queue": "telebudget-updates", "max_batch_size": 1, "max_retries": 3 }] },
  "observability": { "enabled": true }
}
