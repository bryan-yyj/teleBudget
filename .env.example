# Copy this file to .env and fill in the token from BotFather.
# .env is gitignored. Never put a real token in .env.example.
TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token

# Optional: a random 32+ character value used to verify Telegram webhooks.
# Leave blank to have cloudflare/deploy.ps1 generate one in .env.
TELEGRAM_WEBHOOK_SECRET=
