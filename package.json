{
  "name": "telebudget-backend",
  "version": "1.0.0",
  "description": "Budget tracking app with Telegram bot and email integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:cloudflare": "node --experimental-sqlite --test cloudflare/test/*.test.js",
    "lint": "eslint .",
    "typecheck": "echo 'No TypeScript to check'",
    "cf:pages:dev": "wrangler pages dev public --cwd cloudflare/pages",
    "cf:pages:deploy": "wrangler pages deploy public --cwd cloudflare/pages --project-name telebudget --branch main",
    "cf:worker:deploy": "wrangler deploy --config cloudflare/worker/wrangler.jsonc",
    "cf:db:migrate": "wrangler d1 migrations apply telebudget-db --remote --config cloudflare/worker/wrangler.jsonc"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.10.2",
    "moment-timezone": "^0.5.43",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-telegram-bot-api": "^0.61.0",
    "socket.io": "^4.7.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "wrangler": "^4.138.0"
  },
  "keywords": [
    "budget",
    "telegram",
    "email",
    "receipt",
    "tracking"
  ],
  "author": "teleBudget",
  "license": "MIT"
}
